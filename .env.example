# Committed to GitHub as a template only. Copy to `.env` locally.
# `.env` is NOT pushed to GitHub. On Vercel: Settings → Environment Variables → Import .env
# See docs/VERCEL_ENV.md

APP_NAME=Gear AI Agent
# development | staging (Vercel demo) | production
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins for Gear web. If unset, defaults include
# localhost:5173/4173 and https://gearapp.ae (and www/app subdomains).
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://gearapp.ae

# Public Gear API host; keep the API path in GEAR_API_PREFIX.
GEAR_API_BASE_URL=https://gearapp.ae:5001
GEAR_API_PREFIX=/Gear/api
REQUEST_TIMEOUT=15
SESSION_TTL_SECONDS=1800
# Required in production; recommended for multi-instance staging. Use a writable
# Upstash Redis REST token. Never expose it to Web/Mobile clients.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
DEMO_MODE=false
# In demo mode, local avoids network/API charges; hosted uses OpenAI.
DEMO_EXTRACTOR=local

# OpenAI API key stays on the server.
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Optional dedicated customer test token for inspecting getDropdownData.

# Optional development-only MongoDB schema inspection. Use a read-only user.
# GEAR_READONLY_DB_URL=mongodb+srv://gear_ai_reader:<password>@<cluster>/
# GEAR_DB_NAME=gear
